---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import contact from '../data/contact.json';

// ★★★ お問い合わせフォームの受付フラグ / Contact form switch
//
//     いまは false（フォームは表示しますが、送信はできません）。
//     以前は Netlify Forms が送信を受け取っていましたが、Cloudflare には
//     同じしくみがないため、受付先が決まるまで止めてあります。
//     その間のお申し込みは、右側のメール案内でお願いします。
//
//     Was Netlify Forms; Cloudflare has no equivalent, so the form is shown
//     but inert until a backend (Worker route → mail service) exists.
//     To re-enable: set this to true, then make /api/contact real — see README.
const FORM_ENABLED = false;
---
<Base
  title="お問い合わせ・体験レッスン申込｜鶴川はるな坂ピアノ教室（町田市金井・鶴川駅）"
  description="鶴川はるな坂ピアノ教室（町田市金井・小田急線鶴川駅）へのお問い合わせ・体験レッスンのお申し込みはこちら。体験レッスン30〜45分 1,000円。お子さまから大人の方まで受付中です。"
  path="/contact/"
>
  <div class="page-hero">
    <span class="kanji" aria-hidden="true">縁</span>
    <h1>お問い合わせ・体験レッスン申込<span class="en">CONTACT</span></h1>
    <p>{contact.pageLead}</p>
  </div>

  <div class="wrap">
    <div class="contact-grid">

      <!-- ================= お問い合わせフォーム =================
           受付先（送信を受け取るしくみ）が決まるまで、フォームは
           「見えるけれど送信できない」状態にしてあります。
           上の FORM_ENABLED を true にすると、また使えるようになります。 -->
      <form class="contact-form" name="contact" method="POST" action={FORM_ENABLED ? '/api/contact' : undefined}>
        {!FORM_ENABLED && (
          <div class="form-paused">
            <p class="fp-title">ただいまフォームからの送信を停止しています</p>
            <p>
              申し訳ありません。お問い合わせフォームは準備中のため、いまは送信できません。<br>
              お手数ですが、<strong>メール</strong>でお申し込みください（お名前・年齢・ピアノのご経験・ご希望の曜日と時間をお知らせください）。
            </p>
            <p class="fp-mail"><a class="btn btn-primary" href={`mailto:${site.email}`}>メールで申し込む</a></p>
          </div>
        )}
        <input type="hidden" name="form-name" value="contact">
        <p style="display:none;"><label>入力しないでください: <input name="bot-field"></label></p>
        <fieldset disabled={!FORM_ENABLED}>

        <label>お名前（ふりがなもお願いします）<span class="req">必須</span>
          <input type="text" name="お名前" required placeholder="例）山田 花子（やまだ はなこ）">
        </label>

        <label>年齢<span class="req">必須</span>
          <input type="text" name="年齢" required placeholder="例）6歳 / 35歳">
        </label>

        <label>メールアドレス<span class="req">必須</span>
          <input type="email" name="メールアドレス" required placeholder="例）example@email.com">
        </label>

        <label>ピアノのご経験
          <select name="ピアノのご経験">
            <option>初めてです</option>
            <option>少し経験があります</option>
            <option>経験があります（ブランクあり）</option>
            <option>現在も弾いています</option>
          </select>
        </label>

        <label>ご希望の曜日・時間<span class="req">必須</span>
          <input type="text" name="ご希望の曜日時間" required placeholder="例）水曜16時以降、日曜午前 など">
        </label>

        <label>メッセージ（ご質問などがあればどうぞ）
          <textarea name="メッセージ" rows="5" placeholder="ご質問やご希望などをご自由にお書きください"></textarea>
        </label>

        <button class="btn btn-primary" type="submit">送信する</button>
        </fieldset>
      </form>

      <!-- ================= フォーム横の案内 ================= -->
      <div class="contact-aside">
        <h3>{contact.trialTitle}</h3>
        <p>{contact.trialText}</p>

        <h3>メールでのお申し込み</h3>
        <p>フォームの代わりに、メールでもお申し込みいただけます。</p>
        <p class="mail-box"><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p style="margin-top:12px;">メールの場合は、以下をお知らせください。</p>
        <ol>
          <li>お名前（ふりがなもお願いします）</li>
          <li>年齢</li>
          <li>ピアノのご経験があるかどうか</li>
          <li>ご希望の曜日、時間</li>
        </ol>

        <h3>教室の場所</h3>
        <p>{contact.locationText}</p>
      </div>

    </div>
  </div>
</Base>

<style>
  /* fieldset は見た目に出さず、囲むだけ（送信停止のスイッチ用） */
  .contact-form fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }

  /* 送信を止めているあいだの入力欄は、うすいグレーで「いま使えない」と伝えます */
  .contact-form fieldset:disabled { opacity: .55; }
  .contact-form fieldset:disabled input,
  .contact-form fieldset:disabled select,
  .contact-form fieldset:disabled textarea,
  .contact-form fieldset:disabled button { cursor: not-allowed; }

  /* フォームの上に出す「いまは送信できません」のお知らせ */
  .form-paused {
    border: 1px solid var(--brass);
    background: #fff;
    padding: 20px 22px;
    margin-bottom: 30px;
  }
  .form-paused .fp-title {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--green);
    letter-spacing: .06em;
    margin-bottom: 10px;
  }
  .form-paused p { font-size: .9rem; }
  .form-paused .fp-mail { margin-top: 16px; }

  @media (max-width: 720px) {
    .form-paused { padding: 16px 16px; margin-bottom: 24px; }
  }
</style>
