---
// 教室のシンボルのバラ。
// 画像ファイル（rose-mark.svg）ではなく、ここに直接かたちを書いています。
// そうすると、スクロールに合わせて花びらを開かせる（＝咲かせる）ことができます。
// ※ となりに教室名の文字があるので、読み上げソフトからは隠しています。
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<svg class:list={['rose-mark', className]} viewBox="0 0 32 32"
     width="64" height="64" aria-hidden="true" focusable="false">
  <!-- 外がわの、うすい色の花びら（6枚） -->
  <g class="petals-outer" fill="#e8a8bb">
    <ellipse cx="16.00" cy="24.00" rx="6.2" ry="4.9" transform="rotate(180.0 16.00 24.00)"/>
    <ellipse cx="22.93" cy="20.00" rx="6.2" ry="4.9" transform="rotate(120.0 22.93 20.00)"/>
    <ellipse cx="22.93" cy="12.00" rx="6.2" ry="4.9" transform="rotate(60.0 22.93 12.00)"/>
    <ellipse cx="16.00" cy="8.00" rx="6.2" ry="4.9" transform="rotate(0.0 16.00 8.00)"/>
    <ellipse cx="9.07" cy="12.00" rx="6.2" ry="4.9" transform="rotate(-60.0 9.07 12.00)"/>
    <ellipse cx="9.07" cy="20.00" rx="6.2" ry="4.9" transform="rotate(-120.0 9.07 20.00)"/>
  </g>
  <!-- 内がわの、濃い色の花びら（5枚） -->
  <g class="petals-inner" fill="#c34f6f">
    <ellipse cx="18.53" cy="19.48" rx="5.0" ry="4.0" transform="rotate(144.0 18.53 19.48)"/>
    <ellipse cx="20.09" cy="14.67" rx="5.0" ry="4.0" transform="rotate(72.0 20.09 14.67)"/>
    <ellipse cx="16.00" cy="11.70" rx="5.0" ry="4.0" transform="rotate(0.0 16.00 11.70)"/>
    <ellipse cx="11.91" cy="14.67" rx="5.0" ry="4.0" transform="rotate(-72.0 11.91 14.67)"/>
    <ellipse cx="13.47" cy="19.48" rx="5.0" ry="4.0" transform="rotate(-144.0 13.47 19.48)"/>
  </g>
  <!-- まんなか -->
  <circle class="core" cx="16" cy="16" r="2.4" fill="#fdf4f7"/>
</svg>
