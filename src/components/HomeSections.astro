---
// トップページの中身（メインビジュアル〜申し込みへの誘導）です。
// 文章を直したいときは src/data/home.json を編集してください。
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
import home from '../data/home.json';
import profile from '../data/profile.json';
// CMSの欄が空・壊れている場合の予備画像（このファイル自体が消えない限り、
// ビルドは必ず成功します）。
import fallbackHeroImage from '../images/uploads/hero-town.jpg';
import fallbackAboutImage from '../images/uploads/lesson.jpg';
import fallbackProfileImage from '../images/uploads/profile.jpg';

const heroImage = resolveImage(home.hero.image, fallbackHeroImage);
const aboutImage = resolveImage(home.about.image, fallbackAboutImage);
const profileImage = resolveImage(profile.image, fallbackProfileImage);
---
<!-- ================= メインビジュアル ================= -->
<section class="hero">
  <div class="hero-deco" aria-hidden="true">
    <span class="note n1">♪</span>
    <span class="note n2">♩</span>
    <span class="note n3">♫</span>
  </div>
  <div class="hero-inner">
    <div class="hero-left">
      <div class="hero-text">
        <p class="lead">{home.hero.lead}</p>
        <p class="place">{home.hero.place}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/contact/">体験レッスン申込</a>
          <a class="btn btn-ghost" href="#price">料金を見る</a>
        </div>
      </div>
      <h1>{home.hero.titleLine1}<br><em>{home.hero.titleLine2}</em></h1>
    </div>
    <div class="hero-photo">
      <Image src={heroImage} alt="ドイツ・ミュンスターの街並み（先生ゆかりの街）"
             width={1800} fetchpriority="high" loading="eager" decoding="async" />
    </div>
  </div>
</section>

<!-- ================= お知らせ ================= -->
<div class="news">
  <div class="news-inner">
    <h2>お知らせ</h2>
    <ul>
      {home.news.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</div>

<!-- ================= 教室について ================= -->
<section class="block" id="about">
  <div class="wrap">
    <h2 class="stitle"><span class="num">01</span>教室について<span class="en">ABOUT</span></h2>
    <span class="kanji-mark" aria-hidden="true">奏</span>
    <div class="body about-grid">
      <div class="framed"><Image src={aboutImage} alt="鶴川はるな坂ピアノ教室のレッスンの様子"
           width={1400} loading="lazy" decoding="async" /></div>
      <div>
        <p>{home.about.intro}</p>
        <ul class="about-points">
          {home.about.points.map((point) => <li>{point}</li>)}
        </ul>
        <p>{home.about.outro}</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= レッスン内容 ================= -->
<section class="block alt" id="lesson">
  <div class="wrap">
    <h2 class="stitle"><span class="num">02</span>レッスン内容<span class="en">LESSON</span></h2>
    <div class="body lesson-cols">
      <div class="lesson-col">
        <h3>{home.lesson.kidsTitle}</h3>
        <p>{home.lesson.kidsText}</p>
      </div>
      <div class="divider"></div>
      <div class="lesson-col">
        <h3>{home.lesson.adultsTitle}</h3>
        <p>{home.lesson.adultsText}</p>
        <p class="note">{home.lesson.adultsNote}</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= 生徒さんの声 ================= -->
<section class="block" id="voice">
  <div class="wrap">
    <h2 class="stitle"><span class="num">03</span>生徒さんのご感想<span class="en">VOICE</span></h2>
    <span class="kanji-mark" aria-hidden="true">音</span>
    <div class="body voices">
      {home.voices.map((voice) => (
        <div class="voice">
          <p>{voice.text}</p>
          <p class="who">{voice.who}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ================= レッスン日・料金 ================= -->
<section class="block alt" id="price">
  <div class="wrap">
    <h2 class="stitle"><span class="num">04</span>レッスン日・料金<span class="en">PRICE</span></h2>
    <div class="body">

      <div class="days-row">
        <span class="label">レッスン日</span>
        <span class="days">{home.pricing.days}</span>
        <span class="hint">{home.pricing.daysHint}</span>
      </div>

      <div class="trial-highlight">
        <span class="t-name">{home.pricing.trial.label}<small>（{home.pricing.trial.duration}）</small></span>
        <span class="t-price">{home.pricing.trial.price}</span>
        <span class="t-note">{home.pricing.trial.note}</span>
      </div>

      <div class="price-cols">
        {[home.pricing.monthly, home.pricing.single].map((plan) => (
          <div class="price-col">
            <h3>{plan.title}<small>{plan.subtitle}</small></h3>
            <table>
              {plan.rows.map((row) => (
                <tr><td>{row.item}</td><td>{row.price}</td></tr>
              ))}
            </table>
            <p class="note">{plan.note}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<!-- ================= 講師紹介（プロフィールページへの入口） ================= -->
<section class="block" id="teacher">
  <div class="wrap">
    <h2 class="stitle"><span class="num">05</span>講師紹介<span class="en">TEACHER</span></h2>
    <div class="body teacher-teaser">
      <div class="framed"><Image src={profileImage} alt="鶴川はるな坂ピアノ教室 講師 前田河翔子の写真"
           width={1200} loading="lazy" decoding="async" /></div>
      <div>
        <h3>前田河 翔子（まえだこ しょうこ）</h3>
        <p class="en">SHOKO MAEDAKO</p>
        <p style="margin-top:14px;">{home.teacherTeaser.summary}</p>
        <p style="margin-top:20px;"><a class="btn btn-ghost" href="/profile/">プロフィールを詳しく見る</a></p>
      </div>
    </div>
  </div>
</section>

<!-- ================= アクセス ================= -->
<section class="block alt" id="access">
  <div class="wrap">
    <h2 class="stitle"><span class="num">06</span>アクセス<span class="en">ACCESS</span></h2>
    <div class="body access-grid">
      <div>
        <dl class="access-list">
          <div>
            <dt>最寄駅</dt>
            <dd>{home.access.station}</dd>
          </div>
          <div>
            <dt>所在地</dt>
            <dd>{home.access.address}<br><small>{home.access.addressNote}</small></dd>
          </div>
          <div>
            <dt>駐車場</dt>
            <dd>{home.access.parking}</dd>
          </div>
        </dl>
        <p class="area-note">{home.access.areaNote}</p>
      </div>
      <div class="map-frame">
        <iframe
          src="https://www.google.com/maps?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E7%94%BA%E7%94%B0%E5%B8%82%E9%87%91%E4%BA%953%E4%B8%81%E7%9B%AE&z=15&output=embed"
          title="鶴川はるな坂ピアノ教室の周辺地図（町田市金井3丁目）"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>

<!-- ================= 申し込みへの誘導 ================= -->
<div class="keys-divider" aria-hidden="true"></div>
<div class="cta-band">
  <h2>{home.ctaBand.title}</h2>
  <p>{home.ctaBand.text}</p>
  <a class="btn" href="/contact/">お問い合わせ・体験レッスン申込</a>
</div>
